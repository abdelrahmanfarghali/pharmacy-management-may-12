<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         stock.picking (Delivery Slip / Receipt / Internal) – QWeb report
         Inject the generic/scientific name in each move line row.
         ================================================================ -->
    <template id="report_delivery_generic_name" inherit_id="stock.report_delivery_document" priority="15">
        <xpath expr="//span[@t-field='move.product_id']" position="after">
            <t t-if="move.product_id and move.product_id.generic_name">
                <br/>
                <small class="text-muted fst-italic">
                    <t t-esc="move.product_id.generic_name"/>
                </small>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='bo_line.product_id']" position="after">
            <t t-if="bo_line.product_id and bo_line.product_id.generic_name">
                <br/>
                <small class="text-muted fst-italic">
                    <t t-esc="bo_line.product_id.generic_name"/>
                </small>
            </t>
        </xpath>
    </template>

    <template id="report_delivery_has_serial_move_line_generic_name" inherit_id="stock.stock_report_delivery_has_serial_move_line" priority="15">
        <xpath expr="//span[@t-field='move_line.product_id']" position="after">
            <t t-if="move_line.product_id and move_line.product_id.generic_name">
                <br/>
                <small class="text-muted fst-italic">
                    <t t-esc="move_line.product_id.generic_name"/>
                </small>
            </t>
        </xpath>
    </template>

</odoo>
