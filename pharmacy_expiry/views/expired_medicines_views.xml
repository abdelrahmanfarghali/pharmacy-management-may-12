<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         SC2-UC-06: Expired Report — List View
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_expired_report_list" model="ir.ui.view">
        <field name="name">pharmacy.expired.report.list</field>
        <field name="model">pharmacy.expired.report</field>
        <field name="arch" type="xml">
            <list string="Expired Medicines Report"
                  create="false" edit="false" delete="false"
                  decoration-danger="near_expiry_status == 'expired'"
                  decoration-warning="near_expiry_status == 'near_expiry'">
                <field name="location_name" string="Branch / Location"/>
                <field name="product_name"  string="Product"/>
                <field name="lot_name"      string="Lot / Batch"/>
                <field name="expiration_date"/>
                <field name="days_to_expiry" string="Days (negative = expired)"/>
                <field name="qty_on_hand"    string="Qty on Hand"/>
                <field name="near_expiry_status" string="Status"
                       decoration-danger="near_expiry_status == 'expired'"
                       decoration-warning="near_expiry_status == 'near_expiry'"
                       decoration-success="near_expiry_status == 'ok'"/>
            </list>
        </field>
    </record>

    <!-- SC2-UC-06: Search View -->
    <record id="pharmacy_expired_report_search" model="ir.ui.view">
        <field name="name">pharmacy.expired.report.search</field>
        <field name="model">pharmacy.expired.report</field>
        <field name="arch" type="xml">
            <search string="Expired Medicines">
                <field name="product_name"/>
                <field name="lot_name"/>
                <field name="location_name"/>
                <filter string="Expired Only"
                        name="only_expired"
                        domain="[('near_expiry_status','=','expired')]"/>
                <filter string="Near Expiry"
                        name="only_near"
                        domain="[('near_expiry_status','=','near_expiry')]"/>
                <group string="Group By">
                    <filter string="Location / Branch" name="by_location"
                            context="{'group_by':'location_id'}"/>
                    <filter string="Product" name="by_product"
                            context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SC2-UC-06: Action -->
    <record id="action_pharmacy_expired_report" model="ir.actions.act_window">
        <field name="name">Expired Medicines Report</field>
        <field name="res_model">pharmacy.expired.report</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_only_expired': 1}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         SC2-UC-05: Bulk Transfer Wizard
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_expired_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.expired.medicines.wizard.form</field>
        <field name="model">pharmacy.expired.medicines.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Transfer Expired Medicines">
                <sheet>
                    <group>
                        <field name="location_dest_id"/>
                    </group>
                    <group string="Expired Lots to Transfer">
                        <field name="expired_lot_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="expiration_date"/>
                                <field name="days_to_expiry"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_transfer_expired"
                            string="Transfer All to Expired Location"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- SC2-UC-05: Wizard Action -->
    <record id="action_pharmacy_expired_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Expired Medicines</field>
        <field name="res_model">pharmacy.expired.medicines.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Menus — under Inventory
         ══════════════════════════════════════════════════════ -->
    <menuitem id="menu_pharmacy_expiry_root"
              name="Expiry Management"
              parent="stock.menu_stock_root"
              sequence="30"/>

    <menuitem id="menu_pharmacy_expired_report"
              name="Expired Medicines Report"
              parent="menu_pharmacy_expiry_root"
              action="action_pharmacy_expired_report"
              sequence="10"/>

    <menuitem id="menu_pharmacy_expired_transfer"
              name="Bulk Transfer Expired"
              parent="menu_pharmacy_expiry_root"
              action="action_pharmacy_expired_wizard"
              sequence="20"/>

</odoo>
