<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Purchase Order Form View — Consignment Extension
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_purchase_order_form_consignment" model="ir.ui.view">
        <field name="name">purchase.order.form.consignment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- 1. Add Track Stock button to the header toolbar (status bar) -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_track_consignment_stock"
                    string="🔍 Track Stock"
                    type="object"
                    class="btn-secondary"
                    invisible="not is_consignment"
                    help="Open consignment stock tracking pop-up"
                />
            </xpath>

            <!-- 2. Add CONSIGNMENT banner below the header -->
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning o_consignment_banner text-center fw-bold"
                    role="alert"
                    invisible="not is_consignment">
                    <i class="fa fa-tags me-2"/>
                    CONSIGNMENT — التصريف تحت بضاعة
                </div>
            </xpath>

            <!-- 3. Add the consignment checkbox near the Vendor field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="is_consignment"
                    widget="boolean_toggle"
                    readonly="state in ('purchase','done','cancel')"
                    string="Consignment (التصريف تحت بضاعة)"
                />
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Account Move (Vendor Bill) Form — Show consignment lock notice
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_form_consignment" model="ir.ui.view">
        <field name="name">account.move.form.consignment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-info o_consignment_bill_banner text-center"
                    role="alert"
                    invisible="not is_consignment_bill">
                    <i class="fa fa-lock me-2"/>
                    <strong>Consignment Bill</strong> — Quantities are locked to Payable Now values.
                    Linked PO: <field name="consignment_po_id" readonly="1" nolabel="1"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
