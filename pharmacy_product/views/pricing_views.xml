<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- UC-07 + UC-08: Product Form -->
    <record id="product_template_pricing_form" model="ir.ui.view">
        <field name="name">product.template.pricing.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- UC-07: Government Price Lock -->
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_price_locked"/>
            </xpath>

            <!-- UC-08: hide if no purchase history -->
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="has_purchase_history" invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- UC-07: Price History List View -->
    <record id="pharmacy_price_history_list" model="ir.ui.view">
        <field name="name">pharmacy.price.history.list</field>
        <field name="model">pharmacy.price.history</field>
        <field name="arch" type="xml">
            <list string="Price History" create="false" edit="false" delete="false">
                <field name="change_date"/>
                <field name="product_id"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="changed_by"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <!-- UC-07: Price History Action -->
    <record id="action_pharmacy_price_history" model="ir.actions.act_window">
        <field name="name">Price History</field>
        <field name="res_model">pharmacy.price.history</field>
        <field name="view_mode">list</field>
    </record>

    <!-- UC-07: Price History Menu under Inventory > Reporting -->
    <menuitem id="menu_pharmacy_price_history"
              name="Price History"
              parent="stock.menu_stock_root"
              action="action_pharmacy_price_history"
              sequence="25"/>

</odoo>
