<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         product.template – add Generic / Scientific Name to the
         "General Information" tab, immediately below the product name.
         ================================================================ -->
    <record id="product_template_only_form_view_name" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_batch_label_layout"
                        type="object"
                        string="Batch Print Labels"
                        class="btn btn-primary"
                        invisible="not id or not is_medicine"/>
            </xpath>
            <xpath expr="//label[@for='name']" position="replace">
                <field name="is_medicine" invisible="1"/>
                <label for="name" string="Medicine Name" invisible="not is_medicine"/>
                <label for="name" string="Product Name" invisible="is_medicine"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_only_form_view_categ_id" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="is_medicine" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="domain">[('id', 'child_of', %(pharmacy_system.product_category_medicine)d)] if is_medicine else []</attribute>
            </xpath>
            <!-- ('name', '=', 'Medicine') -->

            <xpath expr="//field[@name='categ_id']" position="after">
                <field
                    name="medicine_category_id"
                    domain="[('id', 'child_of', %(pharmacy_system.product_category_medicine)d), ('id', '!=', %(pharmacy_system.product_category_medicine)d)]"
                    context="{
                        'default_parent_id': %(pharmacy_system.product_category_medicine)d,
                        'form_view_ref': 'product.product_category_form_view'
                        }"
                    options="{'no_quick_create': True, 'no_create_edit': False}"
                    invisible="not is_medicine"/>

                <field
                    name="medicine_category_display"
                    readonly="1"
                    invisible="not medicine_category_id"/>
            </xpath>

            <!-- UC-02: Pharmacy Selling Settings group -->
            <xpath expr="//page[@name='general_information']//group[1]" position="inside">
                <group string="Pharmacy Selling Settings" col="2">
                    <field name="pharmacy_product_type" widget="radio"/>
                    <field name="units_per_package"
                           invisible="pharmacy_product_type == 'unit'"
                           required="pharmacy_product_type == 'package'"/>
                    <field name="price_per_unit"
                           invisible="pharmacy_product_type == 'unit'"
                           readonly="1"/>
                    <field name="stock_display" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_generic_name" model="ir.ui.view">
        <field name="name">product.template.form.generic_name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
        
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_medicine" invisible="1"/>
                <span class="w-50 px-1"/>
                <div class="w-75" invisible="not is_medicine">
                    <label for="generic_name" string="Scientific / Generic Name" class="oe_edit_only"/>
                    <field name="generic_name"
                        placeholder="(Optional) e.g. Paracetamol, Sodium Chloride, Cannabis sativa…"
                        class="text-muted fs-5 fw-normal w-100"
                        nolabel="1"/>
                </div>
                <field name="name" invisible="1"/>  <!-- ensure name is in DOM for decoration -->
                <div class="alert alert-warning mt-1 mb-0 py-1 px-2 small" invisible="not generic_name or name != generic_name" role="alert" style="width: fit-content;">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Generic name appears identical to the product name.
                </div>
            </xpath>

        </field>
    </record>

    <!-- ================================================================
         product.template – optional list view column
         ================================================================ -->
    <record id="product_template_list_view_generic_name" model="ir.ui.view">
        <field name="name">product.template.list.generic_name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="generic_name" optional="hide" string="Generic / Scientific Name"/>
            </xpath>

            <!-- UC-02: Pharmacy Selling Settings columns -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="pharmacy_product_type" optional="show"/>
                <field name="units_per_package"   optional="show"/>
                <field name="price_per_unit"       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         product.template – extend the search view so users can filter
         and search by generic_name from the searchbar.
         ================================================================ -->
    <record id="product_template_search_view_generic_name" model="ir.ui.view">
        <field name="name">product.template.search.generic_name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <!-- Searchbar field: typing in the search box offers
                 "Search Generic Name for …" as a suggestion -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="generic_name" string="Generic / Scientific Name" filter_domain="[('generic_name', 'ilike', self)]"/>
            </xpath>

            <!-- Dedicated filter toggle for "has a generic name" -->
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="has_generic_name" string="Has Generic Name" domain="[('generic_name', '!=', False), ('generic_name', '!=', '')]"/>
                <separator/>
            </xpath>

            <!-- UC-02: Filter for pharmacy products -->
            <xpath expr="//filter[@name='categ_id']" position="after">
                <separator/>
                <filter string="Sell As: Unit"
                        name="filter_unit"
                        domain="[('pharmacy_product_type','=','unit')]"/>
                <filter string="Sell As: Package"
                        name="filter_package"
                        domain="[('pharmacy_product_type','=','package')]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Sell Type"
                            name="group_pharmacy_type"
                            context="{'group_by': 'pharmacy_product_type'}"/>
                </group>
            </xpath>
            
        </field>
    </record>

</odoo>
