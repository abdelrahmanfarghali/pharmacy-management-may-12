<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         List View
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_wishlist_list" model="ir.ui.view">
        <field name="name">pharmacy.wishlist.list</field>
        <field name="model">pharmacy.wishlist</field>
        <field name="arch" type="xml">
            <list string="Wishlist Requests"
                  decoration-danger="state == 'cancelled'"
                  decoration-success="state == 'converted'"
                  decoration-warning="state == 'available'"
                  decoration-info="state == 'notified'">
                <field name="request_date"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_requested"/>
                <field name="uom_id"/>
                <field name="qty_on_hand" string="In Stock"/>
                <field name="is_available" widget="boolean" string="Available?"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'cancelled'"
                       decoration-success="state in ('converted',)"
                       decoration-warning="state == 'available'"
                       decoration-info="state == 'notified'"
                       decoration-muted="state == 'pending'"/>
                <field name="sale_order_id" optional="show"/>
                <button name="action_notify_customer"
                        string="Notify"
                        type="object"
                        icon="fa-bell"
                        invisible="state not in ('pending','available')"/>
                <button name="action_convert_to_sale"
                        string="Convert to SO"
                        type="object"
                        icon="fa-shopping-cart"
                        invisible="state in ('converted','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Form View
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_wishlist_form" model="ir.ui.view">
        <field name="name">pharmacy.wishlist.form</field>
        <field name="model">pharmacy.wishlist</field>
        <field name="arch" type="xml">
            <form string="Wishlist Request">
                <header>
                    <button name="action_notify_customer"
                            string="Notify Customer"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('pending','available')"/>
                    <button name="action_convert_to_sale"
                            string="Convert to Sale Order"
                            type="object"
                            class="btn-success"
                            invisible="state in ('converted','cancelled')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('converted','cancelled')"/>
                    <button name="action_reset_pending"
                            string="Reset to Pending"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,available,notified,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" placeholder="Select Product…"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group string="Request Info">
                            <field name="partner_id"/>
                            <field name="qty_requested"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="request_date"/>
                            <field name="note" placeholder="Customer notes…"/>
                        </group>
                        <group string="Stock Info">
                            <field name="qty_on_hand" readonly="1"/>
                            <field name="is_available" readonly="1" widget="boolean_toggle"/>
                            <field name="notified_date"  readonly="1"
                                   invisible="not notified_date"/>
                            <field name="fulfilled_date" readonly="1"
                                   invisible="not fulfilled_date"/>
                            <field name="sale_order_id"  readonly="1"
                                   invisible="not sale_order_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Kanban View
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_wishlist_kanban" model="ir.ui.view">
        <field name="name">pharmacy.wishlist.kanban</field>
        <field name="model">pharmacy.wishlist</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_requested"/>
                <field name="qty_on_hand"/>
                <field name="state"/>
                <field name="is_available"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="fw-bold">
                                <field name="product_id"/>
                            </div>
                            <div class="text-muted small">
                                <field name="partner_id"/>
                            </div>
                            <div class="mt-1">
                                Requested: <field name="qty_requested"/>
                                <span t-if="record.is_available.raw_value"
                                      class="badge bg-success ms-1">In Stock</span>
                                <span t-else=""
                                      class="badge bg-danger ms-1">Out of Stock</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Search View
         ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_wishlist_search" model="ir.ui.view">
        <field name="name">pharmacy.wishlist.search</field>
        <field name="model">pharmacy.wishlist</field>
        <field name="arch" type="xml">
            <search string="Wishlist">
                <field name="partner_id"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Pending"   name="f_pending"
                        domain="[('state','=','pending')]"/>
                <filter string="Available — Notify"  name="f_available"
                        domain="[('state','=','available')]"/>
                <filter string="Notified"  name="f_notified"
                        domain="[('state','=','notified')]"/>
                <filter string="Converted" name="f_converted"
                        domain="[('state','=','converted')]"/>
                <separator/>
                <filter string="In Stock Now" name="f_in_stock"
                        domain="[('state','in',('pending','available','notified'))]"/>
                <group string="Group By">
                    <filter string="Customer" name="g_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Product"  name="g_product"
                            context="{'group_by':'product_id'}"/>
                    <filter string="Status"   name="g_state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Actions
         ══════════════════════════════════════════════════════ -->
    <record id="action_pharmacy_wishlist" model="ir.actions.act_window">
        <field name="name">Wishlist — Customer Requests</field>
        <field name="res_model">pharmacy.wishlist</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_f_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No wishlist requests yet!
            </p>
            <p>
                Record out-of-stock customer requests here.
                The system will automatically notify you when the product is back in stock.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         Menus
         ══════════════════════════════════════════════════════ -->
    <menuitem id="menu_pharmacy_sales_root"
              name="Pharmacy Sales"
              parent="sale.sale_menu_root"
              sequence="20"/>

    <menuitem id="menu_pharmacy_wishlist"
              name="Wishlist (قائمة الأمنيات)"
              parent="menu_pharmacy_sales_root"
              action="action_pharmacy_wishlist"
              sequence="10"/>

</odoo>
