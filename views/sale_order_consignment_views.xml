<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_consignment_batch" model="ir.ui.view">

        <field name="name">sale.order.form.consignment.batch</field>

        <field name="model">sale.order</field>

        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="consignment_po_line_id"/>
            </xpath>

        </field>

    </record>

</odoo>