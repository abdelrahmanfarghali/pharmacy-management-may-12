<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         UC-09: Commission % on Product Form
         ══════════════════════════════════════════════════════ -->
    <record id="product_template_commission_form" model="ir.ui.view">
        <field name="name">product.template.commission.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[1]" position="inside">
                <group string="Commission Settings">
                    <field name="commission_rate" widget="percentage"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
            UC-09: Commission Report — List View
            ══════════════════════════════════════════════════════ -->
    <record id="pharmacy_commission_report_list" model="ir.ui.view">
    <field name="name">pharmacy.commission.ledger.list</field>
    <field name="model">pharmacy.commission.ledger</field>
    <field name="arch" type="xml">
        <list string="Commission Report" create="false" editable="top">
            <header>
                <button name="action_sync_historical_commissions" title="Sync Historical Commissions" type="object" icon="fa-refresh" class="btn-secondary" display="always"/>
            </header>
            <field name="order_date" readonly="1"/>
            <field name="order_ref" readonly="1"/>
            <field name="partner_id" readonly="1"/>
            <field name="product_name" readonly="1"/>
            <field name="commission_rate" widget="percentage" readonly="1"/>
            <field name="price_subtotal" sum="Total Sales" readonly="1"/>
            <field name="commission_amount" sum="Total Commission" readonly="1"/>
            <field name="is_processed" widget="boolean_toggle"/>
            <field name="state" readonly="1"
                    decoration-success="state in ('done','paid','invoiced')"
                    decoration-info="state == 'sale'"
                    decoration-muted="state == 'cancel'"/>
        </list>
    </field>
</record>

    <!-- Commission Report — Search View -->
    <record id="pharmacy_commission_report_search" model="ir.ui.view">
        <field name="name">pharmacy.commission.ledger.search</field>
        <field name="model">pharmacy.commission.ledger</field>
        <field name="arch" type="xml">
            <search string="Commission Report">
                <field name="product_name"/>
                <field name="partner_id"/>
                <field name="order_ref"/>
                <filter string="Confirmed Sales" name="confirmed"
                        domain="[('state','in',('sale','done','paid','invoiced'))]"/>
                <group string="Group By">
                    <filter string="Customer"   name="by_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Product"    name="by_product"
                            context="{'group_by':'product_id'}"/>
                    <filter string="Order Date" name="by_date"
                            context="{'group_by':'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Commission Report — Action -->
    <record id="action_pharmacy_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">pharmacy.commission.ledger</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Commission Report — Menu under Sales > Reporting -->
    <menuitem id="menu_pharmacy_commission_report"
            name="Commission Report"
            parent="sale.menu_sale_report"
            action="action_pharmacy_commission_report"
            sequence="20"/>

</odoo>
