<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        INV-UC-02 — Nightly Expiry Detection Scheduled Action
        Runs daily at 01:00 AM server time.
        noupdate="1" so administrators can change schedule without losing their changes on upgrade.
    -->
    <record id="ir_cron_expiry_detection_nightly" model="ir.cron">
        <field name="name">Pharmacy: Nightly Expired Lot Detection (INV-UC-02)</field>
        <field name="model_id" ref="model_stock_expiry_detection"/>
        <field name="state">code</field>
        <field name="code">model.action_run_scheduled_detection()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <!-- <field name="numbercall">-1</field> -->
        <!-- <field name="doall" eval="False"/> -->
        <field name="active">True</field>
        <!-- next_call will be set by Odoo to tomorrow at this time -->
    </record>

</odoo>
