<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         STOCK PICKING — Form View: Expired Transfer Reason
         Odoo v18 compatible — role + title fixes applied
    ══════════════════════════════════════════════════════════ -->
    <record id="view_picking_form_expired_reason" model="ir.ui.view">
        <field name="name">stock.picking.form.expired.reason</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Hidden computed field — needed for invisible conditions -->
            <xpath expr="//sheet" position="inside">
                <field name="involves_expired_location" invisible="True"/>

                <!-- Warning banner — role="alert" required by Odoo v18 accessibility -->
                <div class="alert alert-danger o_expired_location_warning"
                     role="alert"
                     invisible="not involves_expired_location">
                    <i class="fa fa-exclamation-triangle me-2"
                       title="Expired Location Warning"
                       aria-label="Warning"/>
                    <strong>EXPIRED LOCATION TRANSFER</strong>
                    — This transfer involves a quarantined Expired location.
                    A transfer reason is <strong>mandatory</strong>.
                    Expired stock must never re-enter the active supply chain.
                </div>
            </xpath>

            <!-- Expired Transfer Reason field — inserted after the note field -->
            <xpath expr="//field[@name='note']" position="after">
                <field
                    name="expired_transfer_reason"
                    string="⚠ Expired Transfer Reason"
                    invisible="not involves_expired_location"
                    placeholder="Mandatory: explain why this stock is being moved to/from an Expired location"/>
            </xpath>

        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════
         STOCK PICKING — List View: Expired flag column
         Odoo v18: list (not tree)
    ══════════════════════════════════════════════════════════ -->
    <record id="view_picking_list_expired" model="ir.ui.view">
        <field name="name">stock.picking.list.expired</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field
                    name="involves_expired_location"
                    optional="show"
                    string="Expired?"
                    decoration-danger="involves_expired_location == True"/>
            </xpath>

        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════
         STOCK PICKING — Search View: Expired filter
    ══════════════════════════════════════════════════════════ -->
    <record id="view_picking_search_expired" model="ir.ui.view">
        <field name="name">stock.picking.search.expired</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='picking_type']" position="after">
                <filter
                    name="involves_expired_location"
                    string="Expired Location Transfers"
                    domain="[('involves_expired_location', '=', True)]"/>
            </xpath>

        </field>
    </record>

</odoo>