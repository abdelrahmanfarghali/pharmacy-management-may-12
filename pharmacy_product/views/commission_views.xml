<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- UC-09: Commission % on Product Form -->
    <record id="product_template_commission_form" model="ir.ui.view">
        <field name="name">product.template.commission.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[1]" position="inside">
                <group string="Commission Settings">
                    <field name="commission_rate" widget="percentage"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- UC-09: Commission Report — List View -->
    <record id="pharmacy_commission_report_list" model="ir.ui.view">
        <field name="name">pharmacy.commission.report.list</field>
        <field name="model">pharmacy.commission.report</field>
        <field name="arch" type="xml">
            <list string="Commission Report" create="false" edit="false" delete="false">
                <field name="order_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_name"/>
                <field name="commission_rate"/>
                <field name="price_subtotal"/>
                <field name="commission_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- UC-09: Commission Report — Search View -->
    <record id="pharmacy_commission_report_search" model="ir.ui.view">
        <field name="name">pharmacy.commission.report.search</field>
        <field name="model">pharmacy.commission.report</field>
        <field name="arch" type="xml">
            <search string="Commission Report">
                <field name="product_name"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter string="Confirmed Orders" name="confirmed"
                        domain="[('state','in',('sale','done'))]"/>
                <group string="Group By">
                    <filter string="Customer" name="by_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Product"  name="by_product"
                            context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- UC-09: Commission Report — Action -->
    <record id="action_pharmacy_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">pharmacy.commission.report</field>
        <field name="view_mode">list</field>
    </record>

    <!-- UC-09: Commission Report — Menu -->
    <menuitem id="menu_pharmacy_commission_report"
              name="Commission Report"
              parent="sale.sale_menu_root"
              action="action_pharmacy_commission_report"
              sequence="20"/>

</odoo>
