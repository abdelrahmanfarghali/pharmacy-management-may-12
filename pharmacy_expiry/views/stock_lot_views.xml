<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Inherit Stock Lot Form -->
    <!-- ===================================================== -->
    <record id="stock_lot_form_expiry" model="ir.ui.view">
        <field name="name">stock.lot.form.expiry</field>
        <field name="model">stock.lot</field>

        <!-- Odoo 18 Correct View -->
        <field name="inherit_id" ref="stock.view_production_lot_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="before">

                <group string="Pharmacy Expiry">

                    <group>
                        <field name="expiry_month"
                                placeholder="1-12"/>

                        <field name="expiry_year"
                                placeholder="2027"/>
                    </group>

                    <group>
                        <field name="near_expiry_status"
                                readonly="1"/>

                        <field name="days_to_expiry"
                                readonly="1"/>
                    </group>

                </group>

            </xpath>

        </field>
    </record>

</odoo>