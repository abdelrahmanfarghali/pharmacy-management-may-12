<odoo>

    <record id="view_expired_sale_warning_form" model="ir.ui.view">

        <field name="name">expired.sale.warning.form</field>

        <field name="model">expired.sale.warning.wizard</field>

        <field name="arch" type="xml">

            <form string="Expired Product Warning">

                <sheet>

                    <div class="alert alert-danger">

                        Warning:
                        One or more expired medicine lots were detected.

                    </div>

                    <field name="message"
                           nolabel="1"
                           readonly="1"/>

                </sheet>

                <footer>

                    <button
                        name="action_continue"
                        type="object"
                        string="Continue"
                        class="btn-primary"/>

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>